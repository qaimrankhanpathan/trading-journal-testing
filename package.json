{
  "name": "trading-journal-testing",
  "version": "1.0.0",
  "private": true,
  "description": "Learn Playwright step by step, using the Trading Journal test copy (port 8001) as the practice app.",
  "scripts": {
    "test": "playwright test --project=exercises",
    "solutions": "playwright test --project=solutions",
    "ui": "playwright test --ui",
    "report": "playwright show-report",
    "codegen": "playwright codegen http://localhost:8001",
    "typecheck": "tsc -p . && tsc -p framework",
    "fw:test": "playwright test -c framework",
    "fw:smoke": "playwright test -c framework --grep @smoke",
    "fw:regression": "playwright test -c framework --grep @regression",
    "fw:api": "playwright test -c framework --project=api",
    "fw:ui": "playwright test -c framework --project=desktop",
    "fw:headed": "playwright test -c framework --project=desktop --headed --workers=1",
    "fw:debug": "playwright test -c framework --project=desktop --debug",
    "fw:report": "playwright show-report framework/reports/html",
    "lint": "eslint framework",
    "lint:fix": "eslint framework --fix",
    "format": "prettier --write framework",
    "format:check": "prettier --check framework",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-playwright": "2.11.0",
    "prettier": "3.9.10",
    "typescript": "^5.6.0",
    "typescript-eslint": "8.70.1"
  }
}
