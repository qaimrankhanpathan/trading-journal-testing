# Copy this file to framework/.env and change what you need. framework/.env is never committed (see .gitignore).
# Every value is optional: without a .env file the defaults below are used.

# The journal TEST COPY (start-test.bat). Port 8000 (your real journal) is refused.
BASE_URL=http://localhost:8001

# msedge (Windows default) | chrome | chromium
BROWSER_CHANNEL=msedge

# false = watch the browser while tests run
HEADLESS=true

# Tests running at the same time
WORKERS=2

# Re-runs of a failed test (0 while you work locally)
RETRIES=0

# Milliseconds of delay per browser action, e.g. 500 to watch a test step by step
SLOW_MO=0
